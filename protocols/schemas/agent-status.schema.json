{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AgentStatus",
  "type": "object",
  "required": [
    "run_id",
    "agent_id",
    "agent",
    "status",
    "created_at",
    "updated_at"
  ],
  "properties": {
    "protocol_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+$"
    },
    "run_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9._-]{0,126}[A-Za-z0-9])?$",
      "maxLength": 128
    },
    "agent_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9._-]{0,126}[A-Za-z0-9])?$",
      "maxLength": 128
    },
    "agent": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "enum": [
        "assigned",
        "starting",
        "running",
        "waiting_for_user",
        "done",
        "blocked",
        "failed",
        "stale"
      ]
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "task_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9._-]{0,126}[A-Za-z0-9])?$",
      "maxLength": 128
    },
    "batch_id": {
      "type": "string",
      "minLength": 1
    },
    "attempt": {
      "type": "integer",
      "minimum": 1
    },
    "started_at": {
      "type": "string",
      "format": "date-time"
    },
    "completed_at": {
      "type": "string",
      "format": "date-time"
    },
    "last_heartbeat_at": {
      "type": "string",
      "format": "date-time"
    },
    "resource_class": {
      "type": "string",
      "enum": [
        "light",
        "process",
        "server",
        "browser"
      ]
    },
    "resource_status": {
      "type": "string",
      "enum": [
        "not_required",
        "reserved",
        "starting",
        "running",
        "teardown_pending",
        "cleaned",
        "cleanup_failed",
        "unknown"
      ]
    },
    "teardown_required": {
      "type": "boolean"
    },
    "resource_handles": {
      "type": "object",
      "properties": {
        "pid": {
          "type": "integer",
          "minimum": 1
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "profile_dir": {
          "type": "string",
          "minLength": 1
        },
        "process_label": {
          "type": "string",
          "minLength": 1
        },
        "url": {
          "type": "string",
          "format": "uri",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "cleanup_status": {
      "type": "string",
      "enum": [
        "not_required",
        "pending",
        "in_progress",
        "cleaned",
        "failed",
        "unknown"
      ]
    },
    "reasoning": {
      "$ref": "reasoning-decision.schema.json"
    },
    "resolved_configuration": {
      "$ref": "#/$defs/resolvedConfiguration"
    },
    "trace_evidence": {
      "$ref": "codex-child-trace.schema.json"
    },
    "result_summary": {
      "type": "string",
      "minLength": 1
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "error": {
      "type": "string",
      "minLength": 1
    }
  },
  "dependentRequired": {
    "resource_status": [
      "resource_class"
    ],
    "teardown_required": [
      "resource_class"
    ],
    "resource_handles": [
      "resource_class"
    ],
    "cleanup_status": [
      "resource_class"
    ]
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "resource_class": {
            "const": "light"
          }
        },
        "required": [
          "resource_class"
        ]
      },
      "then": {
        "properties": {
          "teardown_required": {
            "const": false
          },
          "resource_status": {
            "enum": [
              "not_required",
              "unknown"
            ]
          },
          "cleanup_status": {
            "enum": [
              "not_required",
              "unknown"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "resource_class": {
            "const": "process"
          }
        },
        "required": [
          "resource_class"
        ]
      },
      "then": {
        "properties": {
          "resource_status": {
            "enum": [
              "reserved",
              "starting",
              "running",
              "teardown_pending",
              "cleaned",
              "cleanup_failed",
              "unknown"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "resource_class": {
            "enum": [
              "server",
              "browser"
            ]
          }
        },
        "required": [
          "resource_class"
        ]
      },
      "then": {
        "properties": {
          "teardown_required": {
            "const": true
          },
          "resource_status": {
            "enum": [
              "reserved",
              "starting",
              "running",
              "teardown_pending",
              "cleaned",
              "cleanup_failed",
              "unknown"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "done"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "resource_status": {
            "enum": [
              "not_required",
              "cleaned"
            ]
          },
          "cleanup_status": {
            "enum": [
              "not_required",
              "cleaned"
            ]
          }
        }
      }
    },
    {
      "if": {
        "required": ["reasoning"]
      },
      "then": {
        "oneOf": [
          { "properties": { "agent": { "const": "analysis-complexity" }, "reasoning": { "properties": { "role": { "const": "analysis-complexity" } } } } },
          { "properties": { "agent": { "const": "analysis-correctness" }, "reasoning": { "properties": { "role": { "const": "analysis-correctness" } } } } },
          { "properties": { "agent": { "const": "analysis-numerics" }, "reasoning": { "properties": { "role": { "const": "analysis-numerics" } } } } },
          { "properties": { "agent": { "const": "analysis-robustness" }, "reasoning": { "properties": { "role": { "const": "analysis-robustness" } } } } },
          { "properties": { "agent": { "const": "art-director" }, "reasoning": { "properties": { "role": { "const": "art-director" } } } } },
          { "properties": { "agent": { "const": "atomizer" }, "reasoning": { "properties": { "role": { "const": "atomizer" } } } } },
          { "properties": { "agent": { "const": "committee-architect" }, "reasoning": { "properties": { "role": { "const": "committee-architect" } } } } },
          { "properties": { "agent": { "const": "committee-judge" }, "reasoning": { "properties": { "role": { "const": "committee-judge" } } } } },
          { "properties": { "agent": { "const": "committee-kiss" }, "reasoning": { "properties": { "role": { "const": "committee-kiss" } } } } },
          { "properties": { "agent": { "const": "committee-product" }, "reasoning": { "properties": { "role": { "const": "committee-product" } } } } },
          { "properties": { "agent": { "const": "committee-qa" }, "reasoning": { "properties": { "role": { "const": "committee-qa" } } } } },
          { "properties": { "agent": { "const": "committee-security" }, "reasoning": { "properties": { "role": { "const": "committee-security" } } } } },
          { "properties": { "agent": { "const": "compressor" }, "reasoning": { "properties": { "role": { "const": "compressor" } } } } },
          { "properties": { "agent": { "const": "doc-writer" }, "reasoning": { "properties": { "role": { "const": "doc-writer" } } } } },
          { "properties": { "agent": { "const": "executor" }, "reasoning": { "properties": { "role": { "const": "executor" } } } } },
          { "properties": { "agent": { "const": "flow-splitter" }, "reasoning": { "properties": { "role": { "const": "flow-splitter" } } } } },
          { "properties": { "agent": { "const": "generalist" }, "reasoning": { "properties": { "role": { "const": "generalist" } } } } },
          { "properties": { "agent": { "const": "handoff-writer" }, "reasoning": { "properties": { "role": { "const": "handoff-writer" } } } } },
          { "properties": { "agent": { "const": "kanban-manager" }, "reasoning": { "properties": { "role": { "const": "kanban-manager" } } } } },
          { "properties": { "agent": { "const": "market-researcher" }, "reasoning": { "properties": { "role": { "const": "market-researcher" } } } } },
          { "properties": { "agent": { "const": "peon" }, "reasoning": { "properties": { "role": { "const": "peon" } } } } },
          { "properties": { "agent": { "const": "planner" }, "reasoning": { "properties": { "role": { "const": "planner" } } } } },
          { "properties": { "agent": { "const": "repo-scout" }, "reasoning": { "properties": { "role": { "const": "repo-scout" } } } } },
          { "properties": { "agent": { "const": "reviewer" }, "reasoning": { "properties": { "role": { "const": "reviewer" } } } } },
          { "properties": { "agent": { "const": "router" }, "reasoning": { "properties": { "role": { "const": "router" } } } } },
          { "properties": { "agent": { "const": "session-guide-writer" }, "reasoning": { "properties": { "role": { "const": "session-guide-writer" } } } } },
          { "properties": { "agent": { "const": "specifier" }, "reasoning": { "properties": { "role": { "const": "specifier" } } } } },
          { "properties": { "agent": { "const": "summarizer" }, "reasoning": { "properties": { "role": { "const": "summarizer" } } } } },
          { "properties": { "agent": { "const": "test-runner" }, "reasoning": { "properties": { "role": { "const": "test-runner" } } } } },
          { "properties": { "agent": { "const": "ui-ux-designer" }, "reasoning": { "properties": { "role": { "const": "ui-ux-designer" } } } } },
          { "properties": { "agent": { "const": "ux-copy-trust" }, "reasoning": { "properties": { "role": { "const": "ux-copy-trust" } } } } },
          { "properties": { "agent": { "const": "ux-judge" }, "reasoning": { "properties": { "role": { "const": "ux-judge" } } } } },
          { "properties": { "agent": { "const": "ux-novice" }, "reasoning": { "properties": { "role": { "const": "ux-novice" } } } } },
          { "properties": { "agent": { "const": "ux-task-flow" }, "reasoning": { "properties": { "role": { "const": "ux-task-flow" } } } } },
          { "properties": { "agent": { "const": "ux-visual-hierarchy" }, "reasoning": { "properties": { "role": { "const": "ux-visual-hierarchy" } } } } }
        ]
      }
    },
    {
      "if": {
        "required": ["reasoning"],
        "properties": {
          "reasoning": {
            "required": ["schema_version"],
            "properties": { "schema_version": { "const": "3.0" } }
          }
        }
      },
      "then": { "required": ["resolved_configuration"] }
    },
    {
      "if": {
        "required": ["reasoning"],
        "properties": {
          "reasoning": {
            "required": ["schema_version", "mode", "enforcement_status"],
            "properties": {
              "schema_version": { "const": "3.0" },
              "mode": { "const": "adaptive" },
              "enforcement_status": { "const": "enforced" }
            }
          }
        }
      },
      "then": {
        "required": ["resolved_configuration", "trace_evidence"],
        "properties": {
          "trace_evidence": {
            "required": ["trace_found", "role_matches", "model_matches", "effort_matches"],
            "properties": {
              "trace_found": { "const": true },
              "role_matches": { "const": true },
              "model_matches": { "const": true },
              "effort_matches": { "const": true }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "configurationIdentity": {
      "type": "object",
      "required": ["schema_version", "model_set", "reasoning_projection"],
      "properties": {
        "schema_version": { "const": 1 },
        "model_set": {
          "type": "object",
          "required": ["id", "version", "mapping_digest"],
          "properties": {
            "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$" },
            "version": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,31}$" },
            "mapping_digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
          },
          "additionalProperties": false
        },
        "reasoning_projection": {
          "type": "object",
          "required": ["id", "version", "policy_version", "digest"],
          "properties": {
            "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$" },
            "version": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,31}$" },
            "policy_version": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,31}$" },
            "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "resolvedConfiguration": {
      "type": "object",
      "required": ["schema_version", "model_set", "reasoning_projection", "role_binding", "provenance"],
      "properties": {
        "schema_version": { "const": 1 },
        "model_set": { "$ref": "#/$defs/configurationIdentity/properties/model_set" },
        "reasoning_projection": { "$ref": "#/$defs/configurationIdentity/properties/reasoning_projection" },
        "role_binding": {
          "type": "object",
          "required": ["role", "model_tier", "model", "mapping_digest"],
          "properties": {
            "role": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$" },
            "model_tier": { "enum": ["mini", "standard", "strong"] },
            "model": { "type": "string", "pattern": "^(?:gpt-[a-z0-9][a-z0-9.-]{0,62}|o[1-9][a-z0-9.-]{0,62})$" },
            "mapping_digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
          },
          "additionalProperties": false
        },
        "provenance": {
          "type": "object",
          "required": ["source", "override"],
          "properties": {
            "source": { "enum": ["workspace_profile", "pinned_legacy"] },
            "override": {
              "oneOf": [
                { "type": "null" },
                {
                  "type": "object",
                  "required": ["kind", "version", "source_model_tier", "target_model_tier"],
                  "properties": {
                    "kind": { "const": "capability_recovery" },
                    "version": { "const": "1" },
                    "source_model_tier": { "enum": ["mini", "standard", "strong"] },
                    "target_model_tier": { "enum": ["mini", "standard", "strong"] }
                  },
                  "additionalProperties": false
                }
              ]
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "modelMapping": {
      "type": "object",
      "required": ["id", "version", "tiers", "role_overrides", "mapping_digest"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$" },
        "version": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,31}$" },
        "tiers": {
          "type": "object",
          "required": ["mini", "standard", "strong"],
          "properties": {
            "mini": { "type": "string" },
            "standard": { "type": "string" },
            "strong": { "type": "string" }
          },
          "additionalProperties": false
        },
        "role_overrides": {
          "type": "object",
          "propertyNames": { "pattern": "^[a-z][a-z0-9-]{0,63}$" },
          "additionalProperties": {
            "type": "object",
            "required": ["model_tier", "model"],
            "properties": {
              "model_tier": { "enum": ["mini", "standard", "strong"] },
              "model": { "type": "string" }
            },
            "additionalProperties": false
          }
        },
        "mapping_digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
      },
      "additionalProperties": false
    },
    "runConfiguration": {
      "type": "object",
      "required": ["profile", "configuration_compatibility", "model_mapping", "configuration_identity", "resolved_configurations"],
      "properties": {
        "profile": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$" },
        "configuration_compatibility": { "enum": ["current", "pinned", "pinned_legacy"] },
        "model_mapping": { "$ref": "#/$defs/modelMapping" },
        "configuration_identity": { "$ref": "#/$defs/configurationIdentity" },
        "resolved_configurations": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": { "pattern": "^[a-z][a-z0-9-]{0,63}$" },
          "additionalProperties": { "$ref": "#/$defs/resolvedConfiguration" }
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
