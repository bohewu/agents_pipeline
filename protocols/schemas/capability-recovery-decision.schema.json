{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CapabilityRecoveryDecision",
  "description": "Deterministic, content-free decision for one child model recovery request.",
  "type": "object",
  "required": [
    "schema_version",
    "policy_version",
    "mode",
    "role",
    "requested",
    "eligible",
    "failure_type",
    "same_failure",
    "material_failure",
    "no_meaningful_progress",
    "recovery_used",
    "selected_model_tier",
    "recovery_ceiling_model_tier",
    "requested_model_tier",
    "dispatch_model_tier",
    "effective_model_tier",
    "model_matches",
    "model_selector_available",
    "status",
    "reason",
    "conflict",
    "conflict_reason"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "policy_version": {
      "const": "1"
    },
    "mode": {
      "enum": ["off", "shadow", "auto"]
    },
    "role": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,63}$",
      "maxLength": 64
    },
    "requested": {
      "type": "boolean"
    },
    "eligible": {
      "type": "boolean"
    },
    "failure_type": {
      "enum": [
        null,
        "reasoning_failure",
        "timeout",
        "permission_denied",
        "network_error",
        "dependency_unavailable",
        "browser_startup_failure",
        "cli_format_error",
        "tool_failure"
      ]
    },
    "same_failure": {
      "type": "boolean"
    },
    "material_failure": {
      "type": "boolean"
    },
    "no_meaningful_progress": {
      "type": "boolean"
    },
    "recovery_used": {
      "type": "boolean"
    },
    "selected_model_tier": {
      "enum": ["mini", "standard", "strong", "unknown"]
    },
    "recovery_ceiling_model_tier": {
      "enum": [null, "mini", "standard", "strong"]
    },
    "requested_model_tier": {
      "enum": [null, "mini", "standard", "strong"]
    },
    "dispatch_model_tier": {
      "enum": [null, "mini", "standard", "strong"]
    },
    "effective_model_tier": {
      "enum": [null, "mini", "standard", "strong"]
    },
    "model_matches": {
      "type": ["boolean", "null"]
    },
    "model_selector_available": {
      "type": ["boolean", "null"]
    },
    "status": {
      "enum": [
        "not-requested",
        "off",
        "shadow",
        "requested",
        "verified",
        "conflict"
      ]
    },
    "reason": {
      "enum": [
        "not_requested",
        "disabled",
        "role_not_eligible",
        "failure_not_reasoning",
        "failure_not_repeated",
        "failure_not_material",
        "meaningful_progress_present",
        "recovery_already_used",
        "tier_unknown",
        "ceiling_missing",
        "no_higher_tier_available",
        "model_selector_unavailable",
        "awaiting_trace",
        "effective_model_mismatch",
        "effective_model_tier_missing",
        "effective_model_tier_mismatch",
        "eligible",
        "verified"
      ]
    },
    "conflict": {
      "enum": [null, "conflict"]
    },
    "conflict_reason": {
      "type": ["string", "null"],
      "minLength": 1
    },
    "recovery_stage": {
      "$ref": "#/$defs/lsaRecoveryStage"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "conflict"
          }
        },
        "required": ["status"]
      },
      "then": {
        "properties": {
          "conflict": {
            "const": "conflict"
          },
          "conflict_reason": {
            "type": "string"
          },
          "dispatch_model_tier": {
            "const": null
          }
        }
      },
      "else": {
        "properties": {
          "conflict": {
            "const": null
          },
          "conflict_reason": {
            "const": null
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "requested"
          }
        },
        "required": ["status"]
      },
      "then": {
        "properties": {
          "effective_model_tier": {
            "const": null
          },
          "model_matches": {
            "const": null
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "shadow"
          }
        },
        "required": ["status"]
      },
      "then": {
        "properties": {
          "requested_model_tier": {
            "enum": ["mini", "standard", "strong"]
          },
          "dispatch_model_tier": {
            "const": null
          },
          "effective_model_tier": {
            "const": null
          },
          "model_matches": {
            "const": null
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "enum": ["requested", "verified"]
          }
        },
        "required": ["status"]
      },
      "then": {
        "properties": {
          "mode": {
            "const": "auto"
          },
          "eligible": {
            "const": true
          },
          "requested_model_tier": {
            "enum": ["mini", "standard", "strong"]
          },
          "dispatch_model_tier": {
            "enum": ["mini", "standard", "strong"]
          },
          "model_selector_available": {
            "const": true
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "verified"
          }
        },
        "required": ["status"]
      },
      "then": {
        "properties": {
          "effective_model_tier": {
            "enum": ["mini", "standard", "strong"]
          },
          "model_matches": {
            "const": true
          },
          "reason": {
            "const": "verified"
          }
        }
      }
    }
  ],
  "additionalProperties": false,
  "$defs": {
    "lsaRecoveryStage": {
      "type": "object",
      "required": [
        "strategy", "status", "stage", "previous_stage", "requested_effort",
        "dispatch_effort", "uses_model_uplift", "source", "target",
        "latest_verified_effort", "retry_claim", "uplift_claim", "reason",
        "conflict", "conflict_reason"
      ],
      "properties": {
        "strategy": {
          "oneOf": [
            { "type": "null" },
            {
              "type": "object",
              "required": ["id", "version"],
              "properties": {
                "id": { "const": "lsa-qualified-execution-v2" },
                "version": { "const": "2" }
              },
              "additionalProperties": false
            }
          ]
        },
        "status": { "enum": ["off", "shadow", "requested", "verified", "conflict"] },
        "stage": { "enum": [null, "strong-medium", "strong-high", "strong-max"] },
        "previous_stage": { "enum": [null, "source-qualified", "strong-medium", "strong-high"] },
        "requested_effort": { "enum": [null, "medium", "high", "max"] },
        "dispatch_effort": { "enum": [null, "medium", "high", "max"] },
        "uses_model_uplift": { "type": "boolean" },
        "source": { "$ref": "#/$defs/recoveryConfigurationOrNull" },
        "target": { "$ref": "#/$defs/recoveryConfigurationOrNull" },
        "latest_verified_effort": { "enum": [null, "medium", "high", "xhigh", "max"] },
        "retry_claim": {
          "oneOf": [
            { "type": "null" },
            {
              "type": "object",
              "required": ["expected_used", "next_used", "max"],
              "properties": {
                "expected_used": { "type": "integer", "minimum": 0 },
                "next_used": { "type": "integer", "minimum": 0 },
                "max": { "type": "integer", "minimum": 0 }
              },
              "additionalProperties": false
            }
          ]
        },
        "uplift_claim": {
          "oneOf": [
            { "type": "null" },
            {
              "type": "object",
              "required": ["expected_used", "next_used"],
              "properties": {
                "expected_used": { "type": "boolean" },
                "next_used": { "type": "boolean" }
              },
              "additionalProperties": false
            }
          ]
        },
        "reason": { "type": "string", "minLength": 1 },
        "conflict": { "enum": [null, "conflict"] },
        "conflict_reason": { "type": ["string", "null"] }
      },
      "additionalProperties": false
    },
    "recoveryConfigurationOrNull": {
      "oneOf": [
        { "type": "null" },
        { "$ref": "#/$defs/recoveryConfiguration" }
      ]
    },
    "recoveryConfiguration": {
      "type": "object",
      "required": ["model_set", "reasoning_projection", "role_binding", "provenance"],
      "properties": {
        "model_set": {
          "type": "object",
          "required": ["id", "version", "mapping_digest"],
          "properties": {
            "id": { "const": "openai" },
            "version": { "const": "4" },
            "mapping_digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
          },
          "additionalProperties": false
        },
        "reasoning_projection": {
          "type": "object",
          "required": ["id", "version", "policy_version", "digest"],
          "properties": {
            "id": { "const": "openai-gpt6-v1" },
            "version": { "const": "1" },
            "policy_version": { "const": "3" },
            "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
          },
          "additionalProperties": false
        },
        "role_binding": {
          "type": "object",
          "required": ["role", "model_tier", "model", "mapping_digest"],
          "properties": {
            "role": { "enum": ["executor", "generalist"] },
            "model_tier": { "enum": ["standard", "strong"] },
            "model": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$" },
            "mapping_digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
          },
          "additionalProperties": false
        },
        "provenance": {
          "type": "object",
          "required": ["source", "override"],
          "properties": {
            "source": { "const": "workspace_profile" },
            "override": {
              "oneOf": [
                { "type": "null" },
                {
                  "type": "object",
                  "required": ["kind", "version", "source_model_tier", "target_model_tier"],
                  "properties": {
                    "kind": { "const": "capability_recovery" },
                    "version": { "const": "1" },
                    "source_model_tier": { "const": "standard" },
                    "target_model_tier": { "const": "strong" }
                  },
                  "additionalProperties": false
                }
              ]
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  }
}
