{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DispatchPlan",
  "type": "object",
  "required": [
    "batches",
    "notes"
  ],
  "properties": {
    "protocol_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+$"
    },
    "batches": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "batch_id",
          "task_ids",
          "assigned_executor",
          "parallel",
          "resource_class",
          "max_parallelism",
          "teardown_required",
          "notes"
        ],
        "properties": {
          "batch_id": {
            "type": "string"
          },
          "task_ids": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "assigned_executor": {
            "type": "string"
          },
          "reasoning_class": {
            "type": "string",
            "enum": [
              "routine",
              "deliberative",
              "deep",
              "assurance"
            ]
          },
          "reasoning_signals": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "enum": [
                "fully_specified",
                "local_scope",
                "multi_step",
                "cross_module",
                "cross_system",
                "ambiguous_root_cause",
                "architecture_tradeoff",
                "non_local_invariant",
                "adversarial_input",
                "numerical_sensitivity",
                "security_boundary",
                "data_integrity",
                "formal_accept_reject",
                "prior_reasoning_failure",
                "explicit_user_override"
              ]
            }
          },
          "parallel": {
            "type": "boolean"
          },
          "resource_class": {
            "type": "string",
            "enum": [
              "light",
              "process",
              "server",
              "browser"
            ]
          },
          "max_parallelism": {
            "type": "integer",
            "minimum": 1
          },
          "teardown_required": {
            "type": "boolean"
          },
          "timeout_hint_minutes": {
            "type": "integer",
            "minimum": 1
          },
          "notes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "dependentRequired": {
          "reasoning_class": ["reasoning_signals"],
          "reasoning_signals": ["reasoning_class"]
        },
        "allOf": [
          { "$ref": "reasoning-task-hints.schema.json" },
          {
            "if": {
              "properties": {
                "resource_class": {
                  "const": "process"
                }
              }
            },
            "then": {
              "properties": {
                "max_parallelism": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 2
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "resource_class": {
                  "enum": [
                    "server",
                    "browser"
                  ]
                }
              }
            },
            "then": {
              "properties": {
                "task_ids": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 1,
                  "items": {
                    "type": "string"
                  }
                },
                "max_parallelism": {
                  "const": 1
                },
                "teardown_required": {
                  "const": true
                }
              }
            }
          }
        ],
        "additionalProperties": false
      }
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": false
}
