{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ExternalDispatchEvidence",
  "description": "Verified independent Codex exec root returned by codex-external-role.py; it is not a native child trace.",
  "type": "object",
  "required": ["schema_version", "surface", "status", "thread_id", "role", "requested_model", "observed_model", "requested_effort", "observed_effort", "native_managed_child", "checks"],
  "properties": {
    "schema_version": { "const": 1 },
    "surface": { "const": "independent_codex_exec_root" },
    "status": { "const": "verified" },
    "thread_id": { "type": "string", "pattern": "^[0-9a-f]{8}(?:-[0-9a-f]{4}){3}-[0-9a-f]{12}$" },
    "role": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$" },
    "requested_model": { "type": "string", "pattern": "^(?:gpt-[a-z0-9][a-z0-9.-]{0,62}|o[1-9][a-z0-9.-]{0,62})$" },
    "observed_model": { "type": "string", "pattern": "^(?:gpt-[a-z0-9][a-z0-9.-]{0,62}|o[1-9][a-z0-9.-]{0,62})$" },
    "requested_effort": { "enum": ["low", "medium", "high", "xhigh", "max"] },
    "observed_effort": { "enum": ["low", "medium", "high", "xhigh", "max"] },
    "native_managed_child": { "const": false },
    "checks": {
      "type": "object",
      "required": ["approval_never", "completed", "effort", "independent_root", "model", "provider", "role_instructions", "sandbox_policy", "single_turn", "thread_id", "workspace"],
      "properties": {
        "approval_never": { "const": true },
        "completed": { "const": true },
        "effort": { "const": true },
        "independent_root": { "const": true },
        "model": { "const": true },
        "provider": { "const": true },
        "role_instructions": { "const": true },
        "sandbox_policy": { "const": true },
        "single_turn": { "const": true },
        "thread_id": { "const": true },
        "workspace": { "const": true }
      },
      "additionalProperties": false
    }
  },
  "oneOf": [
    { "properties": { "requested_effort": { "const": "low" }, "observed_effort": { "const": "low" } } },
    { "properties": { "requested_effort": { "const": "medium" }, "observed_effort": { "const": "medium" } } },
    { "properties": { "requested_effort": { "const": "high" }, "observed_effort": { "const": "high" } } },
    { "properties": { "requested_effort": { "const": "xhigh" }, "observed_effort": { "const": "xhigh" } } },
    { "properties": { "requested_effort": { "const": "max" }, "observed_effort": { "const": "max" } } }
  ],
  "additionalProperties": false
}
