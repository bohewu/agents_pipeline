{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "FlowTaskList",
  "type": "object",
  "required": [
    "tasks"
  ],
  "properties": {
    "protocol_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+$"
    },
    "tasks": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5,
      "items": {
        "type": "object",
        "required": [
          "id",
          "summary",
          "description",
          "primary_output",
          "assigned_agent",
          "risk",
          "verification",
          "review_required",
          "repair_budget",
          "resource_class",
          "definition_of_done",
          "atomic"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "summary": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string"
          },
          "primary_output": {
            "type": "string",
            "enum": [
              "design",
              "plan",
              "spec",
              "checklist",
              "analysis",
              "implementation"
            ]
          },
          "assigned_agent": {
            "type": "string",
            "enum": [
              "executor",
              "doc-writer",
              "peon",
              "generalist"
            ]
          },
          "risk": {
            "type": "string",
            "enum": [
              "low",
              "medium",
              "high"
            ]
          },
          "task_intent": {
            "enum": [
              null,
              "execute",
              "inspect",
              "diagnose",
              "design",
              "review",
              "certify"
            ]
          },
          "intent_baseline_class": {
            "enum": [null, "routine", "deliberative", "deep", "assurance"]
          },
          "classification_source": {
            "type": "string",
            "enum": [
              "task_intent",
              "legacy_explicit_class",
              "legacy_role_target"
            ]
          },
          "prior_failure_type": {
            "type": "string",
            "enum": [
              "reasoning_failure",
              "timeout",
              "permission_denied",
              "network_error",
              "dependency_unavailable",
              "browser_startup_failure",
              "cli_format_error",
              "tool_failure"
            ]
          },
          "allow_degraded_deep": {
            "type": "boolean",
            "default": false
          },
          "reasoning_class": {
            "type": "string",
            "enum": [
              "routine",
              "deliberative",
              "deep",
              "assurance"
            ]
          },
          "reasoning_signals": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "enum": [
              "fully_specified",
              "local_scope",
              "multi_step",
              "multi_file",
              "bounded_tradeoff",
              "ordinary_diagnosis",
              "implementation_choice",
              "partial_ambiguity",
              "cross_module",
              "cross_system",
              "ambiguous_root_cause",
              "architectural_tradeoff",
              "architecture_tradeoff",
              "non_local_invariant",
              "adversarial_input",
              "numerical_sensitivity",
              "security_boundary",
              "data_integrity",
              "concurrency_or_ordering",
              "migration_compatibility",
              "formal_accept_reject",
              "prior_reasoning_failure",
              "explicit_user_override"
              ]
            }
          },
          "verification": {
            "type": "string",
            "enum": [
              "none",
              "basic",
              "strong"
            ]
          },
          "review_required": {
            "type": "boolean"
          },
          "repair_budget": {
            "type": "integer",
            "minimum": 0,
            "maximum": 2
          },
          "resource_class": {
            "type": "string",
            "enum": [
              "light",
              "process",
              "server",
              "browser"
            ]
          },
          "definition_of_done": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "atomic": {
            "const": true
          }
        },
        "dependentRequired": {
          "reasoning_class": ["reasoning_signals"],
          "reasoning_signals": ["reasoning_class"]
        },
        "allOf": [
          { "$ref": "reasoning-task-hints.schema.json" },
          {
            "if": {
              "properties": {
                "risk": {
                  "const": "medium"
                }
              },
              "required": [
                "risk"
              ]
            },
            "then": {
              "properties": {
                "verification": {
                  "enum": [
                    "basic",
                    "strong"
                  ]
                },
                "repair_budget": {
                  "minimum": 1,
                  "maximum": 2
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "risk": {
                  "const": "high"
                }
              },
              "required": [
                "risk"
              ]
            },
            "then": {
              "properties": {
                "verification": {
                  "const": "strong"
                },
                "review_required": {
                  "const": true
                },
                "repair_budget": {
                  "minimum": 1,
                  "maximum": 2
                }
              }
            }
          }
        ],
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
