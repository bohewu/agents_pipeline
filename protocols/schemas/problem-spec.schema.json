{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ProblemSpec",
  "type": "object",
  "required": [
    "goal",
    "scope",
    "constraints",
    "acceptance_criteria",
    "assumptions"
  ],
  "properties": {
    "protocol_version": {
      "type": "string",
      "enum": [
        "1.0",
        "1.1"
      ]
    },
    "goal": {
      "type": "string",
      "minLength": 1
    },
    "scope": {
      "type": "object",
      "required": [
        "in",
        "out"
      ],
      "properties": {
        "in": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "out": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "constraints": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "acceptance_criteria": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "string"
          },
          {
            "$ref": "#/$defs/sourced_acceptance_criterion"
          }
        ]
      }
    },
    "assumptions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "$defs": {
    "sourced_acceptance_criterion": {
      "type": "object",
      "required": [
        "id",
        "statement",
        "source"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^ac-[a-z0-9._-]+$"
        },
        "statement": {
          "type": "string",
          "minLength": 1
        },
        "source": {
          "type": "string",
          "enum": [
            "explicit_user",
            "existing_contract",
            "necessary_compatibility"
          ]
        },
        "source_ref": {
          "type": "string",
          "minLength": 1
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "source": {
                "enum": [
                  "existing_contract",
                  "necessary_compatibility"
                ]
              }
            },
            "required": [
              "source"
            ]
          },
          "then": {
            "required": [
              "source_ref"
            ]
          }
        }
      ],
      "additionalProperties": false
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "protocol_version": {
            "const": "1.1"
          }
        },
        "required": [
          "protocol_version"
        ]
      },
      "then": {
        "properties": {
          "acceptance_criteria": {
            "items": {
              "$ref": "#/$defs/sourced_acceptance_criterion"
            }
          }
        }
      }
    }
  ],
  "additionalProperties": false
}
