{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ReasoningProjectionRegistry",
  "description": "Immutable, digest-bound class-to-effort projections. The JavaScript policy resolver verifies canonical digests and exact binding behavior.",
  "type": "object",
  "required": ["schema_version", "digest_algorithm", "projections"],
  "properties": {
    "schema_version": { "const": "1" },
    "digest_algorithm": { "const": "sha256" },
    "projections": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": { "$ref": "#/$defs/projection" }
    }
  },
  "allOf": [
    {
      "properties": {
        "projections": {
          "contains": { "properties": { "id": { "const": "legacy-v2" } } }
        }
      }
    },
    {
      "properties": {
        "projections": {
          "contains": { "properties": { "id": { "const": "openai-reviewer-v1" } } }
        }
      }
    },
    {
      "properties": {
        "projections": {
          "contains": { "properties": { "id": { "const": "lsa-efficiency-v1" } } }
        }
      }
    }
  ],
  "additionalProperties": false,
  "$defs": {
    "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "effort": { "enum": ["low", "medium", "high", "xhigh", "max"] },
    "modelTier": { "enum": ["mini", "standard", "strong"] },
    "modelSet": {
      "type": "object",
      "required": ["id", "version", "mapping_digest", "tiers", "role_overrides"],
      "properties": {
        "id": { "enum": ["openai-legacy", "openai", "openai-luna-sol-astra"] },
        "version": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,31}$" },
        "mapping_digest": { "$ref": "#/$defs/digest" },
        "tiers": {
          "type": "object",
          "required": ["mini", "standard", "strong"],
          "properties": {
            "mini": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$" },
            "standard": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$" },
            "strong": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$" }
          },
          "additionalProperties": false
        },
        "role_overrides": { "type": "object" }
      },
      "additionalProperties": false
    },
    "classRequirement": {
      "type": "object",
      "required": ["minimum_model_tier", "effort_by_model_tier"],
      "properties": {
        "minimum_model_tier": { "$ref": "#/$defs/modelTier" },
        "effort_by_model_tier": {
          "type": "object",
          "required": ["mini", "standard", "strong", "unknown"],
          "properties": {
            "mini": { "$ref": "#/$defs/effort" },
            "standard": { "$ref": "#/$defs/effort" },
            "strong": { "$ref": "#/$defs/effort" },
            "unknown": { "$ref": "#/$defs/effort" }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "projection": {
      "type": "object",
      "required": [
        "id",
        "version",
        "policy_version",
        "digest",
        "effort_order",
        "global_floor",
        "model_floors",
        "class_requirements",
        "role_effort_overrides",
        "model_sets"
      ],
      "properties": {
        "id": { "enum": ["legacy-v2", "openai-reviewer-v1", "lsa-efficiency-v1"] },
        "version": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,31}$" },
        "policy_version": { "enum": ["2", "3"] },
        "digest": { "$ref": "#/$defs/digest" },
        "effort_order": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/effort" }
        },
        "global_floor": { "$ref": "#/$defs/effort" },
        "model_floors": {
          "type": "object",
          "required": ["mini", "standard", "strong", "unknown"],
          "properties": {
            "mini": { "$ref": "#/$defs/effort" },
            "standard": { "$ref": "#/$defs/effort" },
            "strong": { "$ref": "#/$defs/effort" },
            "unknown": { "$ref": "#/$defs/effort" }
          },
          "additionalProperties": false
        },
        "class_requirements": {
          "type": "object",
          "required": ["routine", "deliberative", "deep", "assurance"],
          "properties": {
            "routine": { "$ref": "#/$defs/classRequirement" },
            "deliberative": { "$ref": "#/$defs/classRequirement" },
            "deep": { "$ref": "#/$defs/classRequirement" },
            "assurance": { "$ref": "#/$defs/classRequirement" }
          },
          "additionalProperties": false
        },
        "role_effort_overrides": { "type": "object" },
        "model_sets": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/modelSet" }
        }
      },
      "additionalProperties": false
    }
  }
}
