{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TaskList",
  "type": "object",
  "required": [
    "tasks"
  ],
  "properties": {
    "protocol_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+$"
    },
    "tasks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "summary",
          "description",
          "primary_output",
          "owner_hint",
          "risk",
          "complexity",
          "definition_of_done",
          "dependencies"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "summary": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string"
          },
          "primary_output": {
            "type": "string",
            "minLength": 1
          },
          "owner_hint": {
            "type": "string",
            "enum": [
              "executor",
              "peon",
              "generalist",
              "doc-writer"
            ]
          },
          "risk": {
            "type": "string",
            "enum": [
              "low",
              "medium",
              "high"
            ]
          },
          "task_intent": {
            "enum": [
              null,
              "execute",
              "inspect",
              "diagnose",
              "design",
              "review",
              "certify"
            ]
          },
          "intent_baseline_class": {
            "enum": [null, "routine", "deliberative", "deep", "assurance"]
          },
          "classification_source": {
            "type": "string",
            "enum": [
              "task_intent",
              "legacy_explicit_class",
              "legacy_role_target"
            ]
          },
          "prior_failure_type": {
            "type": "string",
            "enum": [
              "reasoning_failure",
              "timeout",
              "permission_denied",
              "network_error",
              "dependency_unavailable",
              "browser_startup_failure",
              "cli_format_error",
              "tool_failure"
            ]
          },
          "allow_degraded_deep": {
            "type": "boolean",
            "default": false
          },
          "reasoning_class": {
            "type": "string",
            "enum": [
              "routine",
              "deliberative",
              "deep",
              "assurance"
            ]
          },
          "reasoning_signals": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "enum": [
              "fully_specified",
              "local_scope",
              "multi_step",
              "multi_file",
              "bounded_tradeoff",
              "ordinary_diagnosis",
              "implementation_choice",
              "partial_ambiguity",
              "cross_module",
              "cross_system",
              "ambiguous_root_cause",
              "architectural_tradeoff",
              "architecture_tradeoff",
              "non_local_invariant",
              "adversarial_input",
              "numerical_sensitivity",
              "security_boundary",
              "data_integrity",
              "concurrency_or_ordering",
              "migration_compatibility",
              "formal_accept_reject",
              "prior_reasoning_failure",
              "explicit_user_override"
              ]
            }
          },
          "complexity": {
            "type": "string",
            "enum": [
              "S",
              "M",
              "L"
            ]
          },
          "definition_of_done": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "dependencies": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "trace_ids": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^(story|sc|ac|tc)-[a-z0-9._-]+$"
            }
          }
        },
        "dependentRequired": {
          "reasoning_class": ["reasoning_signals"],
          "reasoning_signals": ["reasoning_class"]
        },
        "allOf": [
          { "$ref": "reasoning-task-hints.schema.json" }
        ],
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
