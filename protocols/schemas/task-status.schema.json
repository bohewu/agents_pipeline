{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TaskStatus",
  "type": "object",
  "required": [
    "run_id",
    "task_id",
    "summary",
    "status",
    "created_at",
    "updated_at"
  ],
  "properties": {
    "protocol_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+$"
    },
    "run_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9._-]{0,126}[A-Za-z0-9])?$",
      "maxLength": 128
    },
    "task_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9._-]{0,126}[A-Za-z0-9])?$",
      "maxLength": 128
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "ready",
        "in_progress",
        "waiting_for_user",
        "done",
        "blocked",
        "failed",
        "skipped",
        "stale"
      ]
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "trace_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^(story|sc|ac|tc)-[a-z0-9._-]+$"
      }
    },
    "task_intent": {
      "enum": [
        null,
        "execute",
        "inspect",
        "diagnose",
        "design",
        "review",
        "certify"
      ]
    },
    "intent_baseline_class": {
      "enum": [null, "routine", "deliberative", "deep", "assurance"]
    },
    "classification_source": {
      "type": "string",
      "enum": [
        "task_intent",
        "legacy_explicit_class",
        "legacy_role_target"
      ]
    },
    "prior_failure_type": {
      "type": "string",
      "enum": [
        "reasoning_failure",
        "timeout",
        "permission_denied",
        "network_error",
        "dependency_unavailable",
        "browser_startup_failure",
        "cli_format_error",
        "tool_failure"
      ]
    },
    "allow_degraded_deep": {
      "type": "boolean",
      "default": false
    },
    "retry_opportunities_used": {
      "type": "integer",
      "minimum": 0,
      "maximum": 5,
      "description": "Pipeline retry opportunities already charged to this task, including a capability recovery spawn."
    },
    "capability_recovery_used": {
      "type": "boolean",
      "default": false,
      "description": "Whether this task has already consumed its single capability recovery."
    },
    "failure_history": {
      "type": "array",
      "description": "Reasoning failures derived from terminal canonical agent attempts.",
      "items": {
        "type": "object",
        "required": [
          "attempt_id",
          "failure_signature",
          "failure_type",
          "material",
          "meaningful_progress",
          "model_tier",
          "effective_effort"
        ],
        "properties": {
          "attempt_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9._-]{0,126}[A-Za-z0-9])?$",
            "maxLength": 128
          },
          "failure_signature": { "type": "string", "minLength": 1 },
          "failure_type": { "const": "reasoning_failure" },
          "material": { "type": "boolean" },
          "meaningful_progress": { "type": "boolean" },
          "model_tier": { "enum": ["mini", "standard", "strong"] },
          "effective_effort": { "enum": ["low", "medium", "high", "xhigh", "max"] }
        },
        "additionalProperties": false
      }
    },
    "recovery_stage": {
      "allOf": [
        { "$ref": "capability-recovery-decision.schema.json#/$defs/lsaRecoveryStage" },
        {
          "properties": {
            "status": { "enum": ["requested", "verified"] },
            "stage": { "enum": ["strong-medium", "strong-high", "strong-max"] },
            "previous_stage": { "enum": ["source-qualified", "strong-medium", "strong-high"] },
            "requested_effort": { "enum": ["medium", "high", "max"] },
            "dispatch_effort": { "enum": ["medium", "high", "max"] },
            "reason": { "enum": ["qualified_initial_uplift", "qualified_same_uplift_retry", "verified"] },
            "conflict": { "const": null },
            "conflict_reason": { "const": null }
          }
        }
      ]
    },
    "recovery_claim_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9._-]{0,126}[A-Za-z0-9])?$",
      "maxLength": 128
    },
    "recovery_agent_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9._-]{0,126}[A-Za-z0-9])?$",
      "maxLength": 128
    },
    "recovery_runtime_support": {
      "type": "object",
      "required": ["model_selector_available", "effort_selector_available", "supported_efforts", "evidence_ref"],
      "properties": {
        "model_selector_available": { "type": "boolean" },
        "effort_selector_available": { "type": "boolean" },
        "supported_efforts": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "enum": ["low", "medium", "high", "xhigh", "max"] }
        },
        "evidence_ref": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "reasoning_class": {
      "type": "string",
      "enum": [
        "routine",
        "deliberative",
        "deep",
        "assurance"
      ]
    },
    "reasoning_signals": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "fully_specified",
          "local_scope",
          "multi_step",
          "multi_file",
          "bounded_tradeoff",
          "ordinary_diagnosis",
          "implementation_choice",
          "partial_ambiguity",
          "cross_module",
          "cross_system",
          "ambiguous_root_cause",
          "architectural_tradeoff",
          "architecture_tradeoff",
          "non_local_invariant",
          "adversarial_input",
          "numerical_sensitivity",
          "security_boundary",
          "data_integrity",
          "concurrency_or_ordering",
          "migration_compatibility",
          "formal_accept_reject",
          "prior_reasoning_failure",
          "explicit_user_override"
        ]
      }
    },
    "configuration_identity": {
      "$ref": "agent-status.schema.json#/$defs/configurationIdentity"
    },
    "batch_id": {
      "type": "string",
      "minLength": 1
    },
    "depends_on": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9._-]{0,126}[A-Za-z0-9])?$",
        "maxLength": 128
      }
    },
    "assigned_agent_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9._-]{0,126}[A-Za-z0-9])?$",
      "maxLength": 128
    },
    "assigned_executor": {
      "type": "string",
      "minLength": 1
    },
    "resource_class": {
      "type": "string",
      "enum": [
        "light",
        "process",
        "server",
        "browser"
      ]
    },
    "max_parallelism": {
      "type": "integer",
      "minimum": 1
    },
    "teardown_required": {
      "type": "boolean"
    },
    "resource_status": {
      "type": "string",
      "enum": [
        "not_required",
        "reserved",
        "starting",
        "running",
        "teardown_pending",
        "cleaned",
        "cleanup_failed",
        "unknown"
      ]
    },
    "started_at": {
      "type": "string",
      "format": "date-time"
    },
    "completed_at": {
      "type": "string",
      "format": "date-time"
    },
    "last_heartbeat_at": {
      "type": "string",
      "format": "date-time"
    },
    "result_summary": {
      "type": "string",
      "minLength": 1
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "error": {
      "type": "string",
      "minLength": 1
    },
    "resume_note": {
      "type": "string",
      "minLength": 1
    },
    "agent_ref": {
      "type": "object",
      "required": [
        "agent_id",
        "path"
      ],
      "properties": {
        "agent_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9._-]{0,126}[A-Za-z0-9])?$",
          "maxLength": 128
        },
        "path": {
          "type": "string",
          "pattern": "(^|.*[\\\\/])agents[\\\\/][^\\\\/]+\\.json$"
        }
      },
      "additionalProperties": false
    }
  },
  "dependentRequired": {
    "reasoning_class": [
      "reasoning_signals"
    ],
    "reasoning_signals": [
      "reasoning_class"
    ],
    "max_parallelism": [
      "resource_class"
    ],
    "teardown_required": [
      "resource_class"
    ],
    "resource_status": [
      "resource_class"
    ],
    "recovery_stage": [
      "recovery_claim_id",
      "failure_history",
      "retry_opportunities_used",
      "capability_recovery_used",
      "recovery_runtime_support"
    ],
    "recovery_claim_id": [
      "recovery_stage"
    ],
    "recovery_agent_id": [
      "recovery_stage",
      "recovery_claim_id"
    ],
    "recovery_runtime_support": [
      "recovery_stage"
    ]
  },
  "allOf": [
    { "$ref": "reasoning-task-hints.schema.json" },
    {
      "if": {
        "properties": {
          "capability_recovery_used": {
            "const": true
          }
        },
        "required": [
          "capability_recovery_used"
        ]
      },
      "then": {
        "required": [
          "retry_opportunities_used"
        ],
        "properties": {
          "retry_opportunities_used": {
            "minimum": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "resource_class": {
            "const": "light"
          }
        },
        "required": [
          "resource_class"
        ]
      },
      "then": {
        "properties": {
          "teardown_required": {
            "const": false
          },
          "resource_status": {
            "enum": [
              "not_required",
              "unknown"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "resource_class": {
            "const": "process"
          }
        },
        "required": [
          "resource_class"
        ]
      },
      "then": {
        "properties": {
          "max_parallelism": {
            "type": "integer",
            "minimum": 1,
            "maximum": 2
          },
          "resource_status": {
            "enum": [
              "reserved",
              "starting",
              "running",
              "teardown_pending",
              "cleaned",
              "cleanup_failed",
              "unknown"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "resource_class": {
            "enum": [
              "server",
              "browser"
            ]
          }
        },
        "required": [
          "resource_class"
        ]
      },
      "then": {
        "properties": {
          "max_parallelism": {
            "const": 1
          },
          "teardown_required": {
            "const": true
          },
          "resource_status": {
            "enum": [
              "reserved",
              "starting",
              "running",
              "teardown_pending",
              "cleaned",
              "cleanup_failed",
              "unknown"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "done"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "resource_status": {
            "enum": [
              "not_required",
              "cleaned"
            ]
          }
        }
      }
    }
  ],
  "additionalProperties": false
}
