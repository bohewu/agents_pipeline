{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TaskStatus",
  "type": "object",
  "required": [
    "run_id",
    "task_id",
    "summary",
    "status",
    "created_at",
    "updated_at"
  ],
  "properties": {
    "protocol_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+$"
    },
    "run_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9._-]{0,126}[A-Za-z0-9])?$",
      "maxLength": 128
    },
    "task_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9._-]{0,126}[A-Za-z0-9])?$",
      "maxLength": 128
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "ready",
        "in_progress",
        "waiting_for_user",
        "done",
        "blocked",
        "failed",
        "skipped",
        "stale"
      ]
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "trace_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^(story|sc|ac|tc)-[a-z0-9._-]+$"
      }
    },
    "task_intent": {
      "enum": [
        null,
        "execute",
        "inspect",
        "diagnose",
        "design",
        "review",
        "certify"
      ]
    },
    "intent_baseline_class": {
      "enum": [null, "routine", "deliberative", "deep", "assurance"]
    },
    "classification_source": {
      "type": "string",
      "enum": [
        "task_intent",
        "legacy_explicit_class",
        "legacy_role_target"
      ]
    },
    "prior_failure_type": {
      "type": "string",
      "enum": [
        "reasoning_failure",
        "timeout",
        "permission_denied",
        "network_error",
        "dependency_unavailable",
        "browser_startup_failure",
        "cli_format_error",
        "tool_failure"
      ]
    },
    "allow_degraded_deep": {
      "type": "boolean",
      "default": false
    },
    "reasoning_class": {
      "type": "string",
      "enum": [
        "routine",
        "deliberative",
        "deep",
        "assurance"
      ]
    },
    "reasoning_signals": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "fully_specified",
          "local_scope",
          "multi_step",
          "multi_file",
          "bounded_tradeoff",
          "ordinary_diagnosis",
          "implementation_choice",
          "partial_ambiguity",
          "cross_module",
          "cross_system",
          "ambiguous_root_cause",
          "architectural_tradeoff",
          "architecture_tradeoff",
          "non_local_invariant",
          "adversarial_input",
          "numerical_sensitivity",
          "security_boundary",
          "data_integrity",
          "concurrency_or_ordering",
          "migration_compatibility",
          "formal_accept_reject",
          "prior_reasoning_failure",
          "explicit_user_override"
        ]
      }
    },
    "batch_id": {
      "type": "string",
      "minLength": 1
    },
    "depends_on": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9._-]{0,126}[A-Za-z0-9])?$",
        "maxLength": 128
      }
    },
    "assigned_agent_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9._-]{0,126}[A-Za-z0-9])?$",
      "maxLength": 128
    },
    "assigned_executor": {
      "type": "string",
      "minLength": 1
    },
    "resource_class": {
      "type": "string",
      "enum": [
        "light",
        "process",
        "server",
        "browser"
      ]
    },
    "max_parallelism": {
      "type": "integer",
      "minimum": 1
    },
    "teardown_required": {
      "type": "boolean"
    },
    "resource_status": {
      "type": "string",
      "enum": [
        "not_required",
        "reserved",
        "starting",
        "running",
        "teardown_pending",
        "cleaned",
        "cleanup_failed",
        "unknown"
      ]
    },
    "started_at": {
      "type": "string",
      "format": "date-time"
    },
    "completed_at": {
      "type": "string",
      "format": "date-time"
    },
    "last_heartbeat_at": {
      "type": "string",
      "format": "date-time"
    },
    "result_summary": {
      "type": "string",
      "minLength": 1
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "error": {
      "type": "string",
      "minLength": 1
    },
    "resume_note": {
      "type": "string",
      "minLength": 1
    },
    "agent_ref": {
      "type": "object",
      "required": [
        "agent_id",
        "path"
      ],
      "properties": {
        "agent_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9._-]{0,126}[A-Za-z0-9])?$",
          "maxLength": 128
        },
        "path": {
          "type": "string",
          "pattern": "(^|.*[\\\\/])agents[\\\\/][^\\\\/]+\\.json$"
        }
      },
      "additionalProperties": false
    }
  },
  "dependentRequired": {
    "reasoning_class": [
      "reasoning_signals"
    ],
    "reasoning_signals": [
      "reasoning_class"
    ],
    "max_parallelism": [
      "resource_class"
    ],
    "teardown_required": [
      "resource_class"
    ],
    "resource_status": [
      "resource_class"
    ]
  },
  "allOf": [
    { "$ref": "reasoning-task-hints.schema.json" },
    {
      "if": {
        "properties": {
          "resource_class": {
            "const": "light"
          }
        },
        "required": [
          "resource_class"
        ]
      },
      "then": {
        "properties": {
          "teardown_required": {
            "const": false
          },
          "resource_status": {
            "enum": [
              "not_required",
              "unknown"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "resource_class": {
            "const": "process"
          }
        },
        "required": [
          "resource_class"
        ]
      },
      "then": {
        "properties": {
          "max_parallelism": {
            "type": "integer",
            "minimum": 1,
            "maximum": 2
          },
          "resource_status": {
            "enum": [
              "reserved",
              "starting",
              "running",
              "teardown_pending",
              "cleaned",
              "cleanup_failed",
              "unknown"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "resource_class": {
            "enum": [
              "server",
              "browser"
            ]
          }
        },
        "required": [
          "resource_class"
        ]
      },
      "then": {
        "properties": {
          "max_parallelism": {
            "const": 1
          },
          "teardown_required": {
            "const": true
          },
          "resource_status": {
            "enum": [
              "reserved",
              "starting",
              "running",
              "teardown_pending",
              "cleaned",
              "cleanup_failed",
              "unknown"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "done"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "resource_status": {
            "enum": [
              "not_required",
              "cleaned"
            ]
          }
        }
      }
    }
  ],
  "additionalProperties": false
}
